{
  "name": "polly-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "prettier:check": "prettier -c ./app",
    "eslint:check": "eslint . --no-cache --max-warnings=0",
    "knip:test": "yarn knip --max-show-issues 5",
    "knip:cachetest": "yarn knip --cache --max-issues=0",
    "verify:deps-upgrade": "yarn run prettier:check && yarn run eslint:check && yarn run type-check && yarn run jest && yarn run build && yarn knip:test && yarn knip:cachetest",
    "pre-commit:deps-check": "node scripts/precommit-deps-check.mjs",
    "format": "prettier --write \"./app\"",
    "prettier": "prettier --write \"./app\"",
    "prepare": "cd ../../ && husky apps/frontend/.husky",
    "type-check": "tsc --project tsconfig.json --noEmit --skipLibCheck false --incremental false"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts}": [
      "prettier --list-different --write",
      "eslint --cache --max-warnings 0",
      "bash -c 'yarn run type-check'",
      "bash -c 'yarn run jest'",
      "bash -c 'yarn knip --max-show-issues 5'",
      "bash -c 'yarn knip --cache --max-issues=0'"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "ie 11"
    ]
  },
  "dependencies": {
    "@navikt/aksel-icons": "^8.19.2",
    "@navikt/ds-css": "^8.19.2",
    "@navikt/ds-react": "^8.19.2",
    "@navikt/ds-tailwind": "^8.20.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "axios": "^1.20.0",
    "formik": "^2.4.9",
    "husky": "^9.1.7",
    "json-diff-kit": "^1.0.35",
    "lint-staged": "^17.6.0",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "next": "^16.4.2",
    "query-string": "^9.5.1",
    "randomcolor": "^0.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-json-view-lite": "^2.5.0",
    "react-markdown": "^10.1.0",
    "react-process-string": "^1.2.0",
    "react-select": "^5.10.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shortid": "^2.2.17",
    "typescript": "^6.0.3",
    "xlsx": "^0.18.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.2",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "@types/randomcolor": "^0.5.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shortid": "^2.2.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-fixed-jsdom": "^0.0.11",
    "knip": "^6.42.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2"
  },
  "resolutions": {
    "@navikt/ds-react": "patch:@navikt/ds-react@npm%3A8.19.2#~/.yarn/patches/@navikt-ds-react-npm-8.19.2-07df5781d1.patch",
    "json-diff-kit": "patch:json-diff-kit@npm%3A1.0.35#~/.yarn/patches/json-diff-kit-npm-1.0.35-99a2649175.patch"
  },
  "packageManager": "yarn@4.16.0"
}
