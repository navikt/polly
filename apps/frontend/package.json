{
  "name": "polly-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "start": "next dev",
    "build": "next build",
    "serve": "next start",
    "test": "jest",
    "prettier:check": "prettier -c ./src",
    "eslint:check": "eslint . --cache --max-warnings=0",
    "knip:test": "yarn knip --max-show-issues 5",
    "verify:deps-upgrade": "yarn run prettier:check && yarn run eslint:check && yarn run type-check && yarn run build && yarn knip:test",
    "pre-commit:deps-check": "node scripts/precommit-deps-check.mjs",
    "format": "prettier --write \"./src\"",
    "prettier": "prettier --write \"./src\"",
    "prepare": "cd ../../ && husky apps/frontend/.husky",
    "type-check": "tsc --project tsconfig.json --noEmit --skipLibCheck false --incremental false"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts}": [
      "prettier --list-different --write",
      "eslint --max-warnings 0",
      "bash -c 'yarn run type-check'",
      "bash -c 'yarn knip --cache --max-issues=0'",
      "bash -c 'yarn knip --max-show-issues 5'"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "ie 11"
    ]
  },
  "dependencies": {
    "@navikt/aksel-icons": "8.16.1",
    "@navikt/ds-css": "8.16.1",
    "@navikt/ds-react": "8.16.1",
    "@navikt/ds-tailwind": "8.16.1",
    "@tailwindcss/postcss": "4.3.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "axios": "1.19.0",
    "core-js": "3.50.0",
    "flag-icon-css": "4.1.7",
    "formik": "2.4.9",
    "husky": "9.1.7",
    "json-diff-kit": "1.0.35",
    "lint-staged": "17.3.0",
    "lodash": "4.18.1",
    "moment": "2.30.1",
    "next": "16.3.1",
    "query-string": "9.5.0",
    "randomcolor": "0.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-json-view-lite": "2.5.0",
    "react-localization": "2.0.6",
    "react-markdown": "10.1.0",
    "react-process-string": "1.2.0",
    "react-select": "5.10.2",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "shortid": "2.2.17",
    "typescript": "6.0.3",
    "xlsx": "0.18.5",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "4.17.25",
    "@types/node": "26.2.0",
    "@types/randomcolor": "0.5.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/shortid": "2.2.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "autoprefixer": "10.5.4",
    "encoding": "0.1.13",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-fixed-jsdom": "0.0.11",
    "jest-watch-typeahead": "3.0.1",
    "knip": "^6.32.2",
    "node-fetch": "3.3.2",
    "postcss": "8.5.26",
    "postcss-import": "16.2.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "ts-jest": "^29.4.12",
    "ts-node": "10.9.2"
  },
  "packageManager": "yarn@4.18.0"
}
