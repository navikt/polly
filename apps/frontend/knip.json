{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "exports": "warn",
    "duplicates": "warn"
  },
  "entry": ["pages/**/*.{tsx,ts}", "*.config.{mjs,mts}", "scripts/**/*.mjs"],
  "project": ["**/*.{tsx,ts,mjs,mts}"]
}
